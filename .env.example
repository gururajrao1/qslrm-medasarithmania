DATABASE_URL=sqlite:///./data/processed/qslrm.db
# SQLite-first local default (matches README + Render free tier).
# Docker/Postgres alternative:
# DATABASE_URL=postgresql+psycopg://qslrm:qslrm@localhost:5432/qslrm
MVP_DRUG_CLASS=kinase_inhibitor
MODEL_VERSION=qslrm-v1.0.0
FAERS_MAX_PER_DRUG=100
FAERS_PAGE_SIZE=100
CHEMBL_ACTIVITY_LIMIT=200
HOST=0.0.0.0
PORT=8000
QSLRM_BOOTSTRAP=1
QSLRM_SEED_PIPELINE=1
# Comma-separated origins allowed to call the API from a browser (CORS).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
